*.txt
!CMakeLists.txt
!package.xml
!requirements.txt
!OrbbecSDK.log.txt

# Binary libraries and build artifacts
*.so
*.so.*
*.dylib
*.dll
*.lib
*.pdb
*.exe

# Exception: Vendored prebuilt binaries (not build artifacts)
!libdev_*/**/*.so
!libdev_*/**/*.so.*
!libdev_*/**/*.dylib
!libdev_*/**/*.dll
!libdev_*/**/*.lib
!libdev_*/**/*.pdb
!libdev_*/**/*.exe
!obsbot_helper/obsbot_ctrl
!libdev_*/**/*.so
!libdev_*/**/*.so.*
!libdev_*/**/*.dylib
!libdev_*/**/*.dll
!libdev_*/**/*.lib
!libdev_*/**/*.pdb
!libdev_*/**/*.exe

# Large binary models and runtime libraries
lib/
models/
vosk-models/

# Temporary agent scripts
scripts/rosagent_*.py

# Robot-specific configurations — each robot maintains its own untracked copy.
# See src/aimee_bringup/config/robots/default.yaml for the template.
src/aimee_bringup/config/robots/*.yaml
# Keep the template and examples tracked:
!src/aimee_bringup/config/robots/default.yaml
!src/aimee_bringup/config/robots/*.example.yaml
