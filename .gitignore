# Colcon / ROS2 build artifacts
build/
install/
log/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/

# Core dumps
core.*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment / Secrets
.env
.env.local

# OS
.DS_Store
Thumbs.db

